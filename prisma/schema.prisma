generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  registerNum     String   @unique
  password        String
  lastSyncDashboard DateTime?
  lastSyncFinance   DateTime?
  lastSyncGrades    DateTime?
  lastSyncLibrary   DateTime?
  lastSyncSubjects  DateTime?
  lastSyncProfile   DateTime?
  lastSyncLeaves    DateTime?
  
  // Admin & Rate Limit
  role            String   @default("USER") // "USER" or "ADMIN"
  status          String   @default("ACTIVE") // "ACTIVE", "BLACKLISTED", "WHITELISTED"
  sessionVersion  Int      @default(1)
  customRateLimit Int?
  
  // Customization
  mobileNav       String?

  
  // JSON blobs to cache the data for each section
  dashboardCache  String?
  financeCache    String?
  gradesCache     String?
  libraryCache    String?
  subjectsCache   String?
  profileCache    String?
  leavesCache     String?

  // Relations
  scrapeLogs      ScrapeLog[]
  suggestions     Suggestion[]
  userTimetables  UserTimetable[]
  subjectAliases  SubjectAlias[]
}

model SubjectAlias {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  alias     String
  updatedAt DateTime @updatedAt

  @@unique([userId, subject])
}

model UserTimetable {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId   String   
  dayOrder  String   // "1", "2", "3", "4", "5", "6"
  period    String   // "1", "2", "3", "4", "5"
  subject   String   
  updatedAt DateTime @updatedAt

  @@unique([userId, dayOrder, period]) 
  @@index([classId, dayOrder, period]) 
}

model ClassTimetable {
  id             String   @id @default(uuid())
  classId        String
  dayOrder       String
  period         String
  subject        String
  consensusCount Int
  updatedAt      DateTime @updatedAt

  @@unique([classId, dayOrder, period])
}

model ScrapeLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint     String
  status       String   // "SUCCESS" or "ERROR"
  fullLog      String?  // Optional payload for failures
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  id           String   @id @default(uuid())
  key          String   @unique
  value        String
  updatedAt    DateTime @updatedAt
}

model Announcement {
  id           String   @id @default(uuid())
  title        String
  content      String
  targetRole   String?  @default("ALL") // "ALL", "USER", "ADMIN"
  createdAt    DateTime @default(now())
}

model Suggestion {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String
  adminReply   String?
  createdAt    DateTime @default(now())
  repliedAt    DateTime?

  @@index([createdAt])
}
